-- ────────────────────────────────────────────────────────────────────────────
-- AI Adoption & Feedback Tracker — schema
--
-- Rendered by Terraform from sql/schema.sql.tftpl: the table names below come
-- from var.table_names, so this file and the Lambdas cannot disagree about
-- what anything is called.
--
-- Every statement is idempotent. Re-running this is how the schema is applied,
-- so it has to be safe to run twice.
-- ────────────────────────────────────────────────────────────────────────────

CREATE EXTENSION IF NOT EXISTS vector;
CREATE EXTENSION IF NOT EXISTS "uuid-ossp";

-- ────────────────────────────────────────────────────────────────────────────
-- Per-agent configuration.
--
-- api_key_hash is a SHA-256 of the issued key; the key itself is never stored,
-- so a database dump does not hand over working credentials.
--
-- threshold_minutes sits beside threshold_days for one reason worth stating
-- plainly: a demo cannot wait fourteen days for a survey to become due. When
-- it is set it wins, and it is per-agent configuration rather than a global
-- flag, so turning it on for a demo agent leaves every real agent alone.
-- ────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS ${agent_config} (
    agent_id          TEXT PRIMARY KEY,
    display_name      TEXT,
    api_key_hash      TEXT        NOT NULL,
    threshold_days    INTEGER     NOT NULL DEFAULT 14,
    threshold_minutes INTEGER,
    platform          TEXT,
    is_active         BOOLEAN     NOT NULL DEFAULT TRUE,
    created_at        TIMESTAMPTZ NOT NULL DEFAULT now(),
    updated_at        TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- ────────────────────────────────────────────────────────────────────────────
-- Usage events.
--
-- event_id is UNIQUE and every insert is ON CONFLICT DO NOTHING. That is the
-- whole idempotency story: a retried batch cannot double-count, and it costs
-- one index rather than a conditional-write dance in application code.
-- ────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS ${usage_events} (
    id             BIGSERIAL PRIMARY KEY,
    event_id       TEXT        NOT NULL UNIQUE,
    agent_id       TEXT        NOT NULL,
    acf2_id        TEXT        NOT NULL,
    platform       TEXT        NOT NULL,
    business_group TEXT,
    division       TEXT,
    event_type     TEXT        NOT NULL DEFAULT 'invocation',
    occurred_at    TIMESTAMPTZ NOT NULL DEFAULT now(),
    metadata       JSONB       NOT NULL DEFAULT '{}'::jsonb,
    received_at    TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_${usage_events}_agent_time
    ON ${usage_events} (agent_id, occurred_at DESC);

-- Adoption by org unit is the headline query; this is the index behind it.
CREATE INDEX IF NOT EXISTS idx_${usage_events}_org
    ON ${usage_events} (agent_id, business_group, division);

-- ────────────────────────────────────────────────────────────────────────────
-- First use per (agent, user).
--
-- Written with ON CONFLICT DO NOTHING so the recorded date never drifts
-- forward on a later event — which would quietly reset everyone's feedback
-- threshold and mean no survey ever becomes due.
-- ────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS ${first_use} (
    agent_id       TEXT        NOT NULL,
    acf2_id        TEXT        NOT NULL,
    first_use_at   TIMESTAMPTZ NOT NULL DEFAULT now(),
    platform       TEXT,
    business_group TEXT,
    division       TEXT,
    PRIMARY KEY (agent_id, acf2_id)
);

-- ────────────────────────────────────────────────────────────────────────────
-- Feedback.
--
-- Structured fields stay separate columns rather than one JSON blob, so
-- sentiment and time_saved aggregate in SQL. barrier_embedding is the free-text
-- barrier as a Titan v2 vector, filled in by the embedding job.
-- ────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS ${feedback_responses} (
    response_id       TEXT PRIMARY KEY,
    agent_id          TEXT        NOT NULL,
    acf2_id           TEXT        NOT NULL,
    sentiment         TEXT,
    time_saved        NUMERIC(8,2),
    barriers          TEXT,
    value_signals     JSONB       NOT NULL DEFAULT '{}'::jsonb,
    barrier_embedding vector(${embedding_dimension}),
    theme_id          TEXT,
    submitted_at      TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- One response per person per agent — a user who has answered is not asked again.
CREATE UNIQUE INDEX IF NOT EXISTS idx_${feedback_responses}_agent_user
    ON ${feedback_responses} (agent_id, acf2_id);

-- The embedding job's worklist: rows with text and no vector yet.
CREATE INDEX IF NOT EXISTS idx_${feedback_responses}_unembedded
    ON ${feedback_responses} (agent_id)
    WHERE barrier_embedding IS NULL AND barriers IS NOT NULL;

-- ────────────────────────────────────────────────────────────────────────────
-- Barrier themes.
--
-- "The docs are confusing" and "I couldn't find any documentation" are one
-- theme and no amount of string matching will ever see that. Barriers are
-- embedded, clustered by cosine distance against these centroids, and the
-- clusters are named by a single batched model call — rather than asking a
-- model to both discover and name themes from a wall of raw text.
-- ────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS ${barrier_themes} (
    theme_id     TEXT PRIMARY KEY,
    agent_id     TEXT        NOT NULL,
    label        TEXT,
    centroid     vector(${embedding_dimension}) NOT NULL,
    member_count INTEGER     NOT NULL DEFAULT 0,
    generated_at TIMESTAMPTZ NOT NULL DEFAULT now()
);

CREATE INDEX IF NOT EXISTS idx_${barrier_themes}_agent_rank
    ON ${barrier_themes} (agent_id, member_count DESC);

-- IVFFlat needs training rows before it beats a sequential scan, and at demo
-- volumes it would not. HNSW builds on an empty table and stays correct as
-- rows arrive, which matters more here than raw speed.
CREATE INDEX IF NOT EXISTS idx_${barrier_themes}_centroid
    ON ${barrier_themes} USING hnsw (centroid vector_cosine_ops);

-- ────────────────────────────────────────────────────────────────────────────
-- Leadership briefings.
--
-- Generated on a schedule and read from cache, so dashboard traffic does not
-- turn into agent invocations. citations holds the figures the briefing cited,
-- which is what makes "every claim traceable to a number" checkable after the
-- fact rather than a claim about the prompt.
-- ────────────────────────────────────────────────────────────────────────────

CREATE TABLE IF NOT EXISTS ${insight_briefings} (
    id             TEXT PRIMARY KEY,
    agent_id       TEXT        NOT NULL,
    summary        TEXT,
    insight        TEXT,
    recommendation TEXT,
    citations      JSONB       NOT NULL DEFAULT '[]'::jsonb,
    model_id       TEXT,
    status         TEXT        NOT NULL DEFAULT 'ok',
    generated_at   TIMESTAMPTZ NOT NULL DEFAULT now()
);

-- The panel reads the newest row for an agent; this is that lookup.
CREATE INDEX IF NOT EXISTS idx_${insight_briefings}_agent_time
    ON ${insight_briefings} (agent_id, generated_at DESC);
